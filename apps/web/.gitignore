# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# SvelteKit / Vite
.svelte-kit/
build/
dist/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Netlify CLI local link state — machine-specific, not shared
.netlify/

# Environment — never commit real secrets; .env.example is the template
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Editor & tooling
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.eslintcache
*.tsbuildinfo

# OS cruft
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
._*

# Font download archives (fonts live unpacked in static/fonts/)
*.zip

# Local scratch: uncropped photo originals, working files. Nothing here ships.
# Shipped art lives in static/images/ — see README "Images".
.drafts/
